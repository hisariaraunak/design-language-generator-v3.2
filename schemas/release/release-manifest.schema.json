{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "generator_version",
    "design_system_version",
    "release_status",
    "completion",
    "files",
    "approvals",
    "created_at",
    "execution_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "3.2.0"
    },
    "generator_version": {
      "const": "3.2.0"
    },
    "design_system_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "release_status": {
      "enum": [
        "Production",
        "ReferenceVerified",
        "ReleaseCandidate"
      ]
    },
    "completion": {
      "type": "object",
      "required": [
        "design_language",
        "design_system",
        "production_verified",
        "governed_release"
      ],
      "properties": {
        "design_language": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "design_system": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "production_verified": {
          "enum": [
            "pass",
            "fail",
            "reference_pass"
          ]
        },
        "governed_release": {
          "enum": [
            "pending",
            "pass"
          ]
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "object",
      "required": [
        "gate_a",
        "gate_b"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "execution_profile": {
      "enum": [
        "reference",
        "production"
      ]
    }
  },
  "additionalProperties": false
}
