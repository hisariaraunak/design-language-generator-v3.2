{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "capability",
    "entrypoint",
    "inputs",
    "outputs",
    "sandbox",
    "sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "capability": {
      "enum": [
        "ingest",
        "render",
        "codegen",
        "compile",
        "snapshot",
        "accessibility",
        "localization",
        "motion",
        "performance",
        "device",
        "asset",
        "migration",
        "registry"
      ]
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^adapters/[a-zA-Z0-9_./-]+\\.py$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.).+$"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.).+$"
      }
    },
    "sandbox": {
      "type": "object",
      "required": [
        "network",
        "timeout_seconds",
        "max_memory_mb"
      ],
      "properties": {
        "network": {
          "enum": [
            "none",
            "allowlisted"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 32768
        }
      },
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
