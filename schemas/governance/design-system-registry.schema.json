{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "current_version",
    "generator_version",
    "releases"
  ],
  "properties": {
    "current_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generator_version": {
      "const": "3.2.0"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "manifest_sha256",
          "archive_sha256",
          "released_at",
          "status",
          "supported_platforms",
          "superseded_by"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "released_at": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Production",
              "ReferenceVerified",
              "ReleaseCandidate"
            ]
          },
          "supported_platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "additionalProperties": false
}
