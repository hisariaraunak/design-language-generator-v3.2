{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "domain",
    "archetype",
    "source_mode",
    "screens",
    "platforms",
    "constraints"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "domain": {
      "enum": [
        "minimal",
        "fitness",
        "fintech",
        "ecommerce",
        "productivity",
        "media"
      ]
    },
    "archetype": {
      "type": "string"
    },
    "source_mode": {
      "enum": [
        "brief",
        "screenshots",
        "existing_app",
        "codebase"
      ]
    },
    "screens": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "web",
          "swiftui",
          "compose"
        ]
      }
    },
    "constraints": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
