{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "platforms",
    "rules"
  ],
  "properties": {
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "surface",
          "classification",
          "rationale"
        ],
        "properties": {
          "surface": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "must_match",
              "platform_native",
              "allowed_divergence"
            ]
          },
          "tolerance": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
