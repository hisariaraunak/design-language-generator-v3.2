{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "generator_version",
    "adapter_id",
    "adapter_sha256",
    "records"
  ],
  "properties": {
    "generator_version": {
      "const": "3.2.0"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "requirement_id",
          "status",
          "evidence_class",
          "verifier_id",
          "test",
          "fixture",
          "environment",
          "expected",
          "actual",
          "artifacts",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "requirement_id": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unverified",
              "not_applicable"
            ]
          },
          "evidence_class": {
            "enum": [
              "reference_fixture",
              "trusted_verifier",
              "manual_observation"
            ]
          },
          "verifier_id": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "string",
            "minLength": 1
          },
          "fixture": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "required": [
              "generator_version"
            ],
            "properties": {
              "generator_version": {
                "const": "3.2.0"
              }
            },
            "additionalProperties": true
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "created_at": {
            "type": "string"
          },
          "invalidated_at": {
            "type": "string"
          },
          "invalidated_reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
