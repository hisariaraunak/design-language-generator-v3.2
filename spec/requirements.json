    "brand_guidelines",
    "greenfield_brief"
  ],
  "engines": {
    "intake": [
      "scope normalization",
      "source inventory",
      "applicability matrix"
    ],
    "design_generation": [
      "visual DNA",
      "directions",
      "baselines",
      "language",
      "tokens",
      "components"
    ],
    "rendering_codegen": [
      "playgrounds",
      "canonical screens",
      "web",
      "swiftui",
      "compose"
    ],
    "verification": [
      "snapshots",
      "accessibility",
      "responsive",
      "localization",
      "motion",
      "determinism",
      "performance",
      "device",
      "privacy",
      "regression"
    ],
    "release": [
      "checksums",
      "manifest",
      "archive",
      "release blocking"
    ],
    "governance_migration": [
      "semver",
      "deprecation",
      "compatibility",
      "registry",
      "rollback",
      "migration policy",
      "adoption drift"
    ]
  },
  "evidence": {
    "required_fields": [
      "requirement",
      "test",
      "fixture",
      "environment",
      "expected",
      "actual",
      "artifact_checksums",
      "status"
