  "security": [
    "no arbitrary command adapters",
    "root-contained paths",
    "schema-validated state",
    "auditable history",
    "checksum-bound evidence"
  ],
  "acceptance": "A clean reference project must run end-to-end with human intervention only at Gate A and Gate B."
